---
import '../styles/global.css';
import '../styles/glass.css';
import '../styles/typography.css';
import '../styles/components.css';
import { AiChat } from '../components/AiChat';

interface Props {
  title: string;
}
const { title } = Astro.props;

const NAV_LINKS = [
  { href: '/', label: 'Dashboard', hint: 'Your training at a glance' },
  { href: '/workouts', label: 'Workouts', hint: 'Log and review sessions' },
  { href: '/exercises', label: 'Exercises', hint: 'Your exercise library' },
  { href: '/analytics', label: 'Analytics', hint: 'Progress and trends' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const token = Astro.cookies.get('session')?.value;
let displayName = '';
if (token) {
  try {
    const res = await fetch(`${import.meta.env.PUBLIC_API_BASE}/auth/me`, {
      headers: { Authorization: `Bearer ${token}` },
    });
    if (res.ok) {
      const me = await res.json();
      displayName = me.name || me.email;
    }
  } catch {
    displayName = '';
  }
}
---

<script define:vars={{ token }} is:inline>
  window.__SESSION_TOKEN__ = token;
</script>

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="../../icon.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Strength Trainer</title>
  </head>
  <AiChat client:load />
  <body>
    <input type="checkbox" id="nav-toggle" class="nav-checkbox" aria-hidden="true" tabindex="-1" />
    <nav class="glass--heavy site-nav">
      <div class="container site-nav-row">
        <a href="/" class="logo">
          <span class="text-glow">Strength Trainer</span>
        </a>
        <div class="nav-links">
          {NAV_LINKS.map((l) => (
            <a href={l.href} class:list={{ active: isActive(l.href) }} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
          ))}
        </div>
        <div class="profile-display">
          {displayName && <span class="text-muted">Hi {displayName}</span>}
          <a href="/api/auth/logout" class="btn btn-ghost btn-sm">Logout</a>
        </div>
        <label for="nav-toggle" class="nav-toggle" aria-label="Toggle menu" role="button" tabindex="0">
          <span></span><span></span><span></span>
        </label>
      </div>
    </nav>

    <div class="nav-overlay" id="nav-overlay">
      <div class="nav-overlay-inner">
        <ul class="nav-overlay-links">
          {NAV_LINKS.map((l, i) => (
            <li style={`--i: ${i}`}>
              <a href={l.href} class:list={{ active: isActive(l.href) }} aria-current={isActive(l.href) ? 'page' : undefined}>
                <span class="nav-overlay-num">0{i + 1}</span>
                <span class="nav-overlay-text">
                  <span class="nav-overlay-label">{l.label}</span>
                  <span class="nav-overlay-hint">{l.hint}</span>
                </span>
                <span class="nav-overlay-arrow">→</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="nav-overlay-footer" style={`--i: ${NAV_LINKS.length}`}>
          {displayName && (
            <div class="nav-overlay-user">
              <span class="nav-overlay-avatar">{displayName.trim().charAt(0).toUpperCase()}</span>
              <span>{displayName}</span>
            </div>
          )}
          <a href="/api/auth/logout" class="btn btn-ghost">Logout</a>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var cb = document.getElementById('nav-toggle');
        var toggle = document.querySelector('.nav-toggle');
        function close() { cb.checked = false; }
        document.querySelectorAll('.nav-overlay a').forEach(function (a) { a.addEventListener('click', close); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
        toggle.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); cb.checked = !cb.checked; }
        });
        window.matchMedia('(min-width: 769px)').addEventListener('change', function (m) { if (m.matches) close(); });
        // Restored from back/forward cache with the menu open
        window.addEventListener('pageshow', close);
      })();
    </script>
    <main class="container">
      <slot />
    </main>
  </body>
</html>

<style>
  /* ── Top bar ── */
  .nav-checkbox { position: absolute; opacity: 0; pointer-events: none; }
  .site-nav {
    position: sticky; top: 0; z-index: 1200;
    border-bottom: 1px solid var(--glass-border);
    padding: 0.75rem 0;
  }
  .site-nav-row { display: flex; align-items: center; gap: 2rem; }
  .logo { font-weight: 700; font-size: 1.25rem; color: var(--green-100); letter-spacing: -0.02em; white-space: nowrap; }
  .nav-links { display: flex; gap: 0.25rem; flex: 1; }
  .nav-links a {
    color: var(--text-secondary); font-weight: 500; font-size: 0.9375rem;
    padding: 0.375rem 0.75rem; border-radius: var(--radius-pill);
    transition: color 0.2s, background 0.2s;
  }
  .nav-links a:hover { color: var(--green-300); background: var(--glass-bg); }
  .nav-links a.active { color: var(--green-100); background: var(--glass-bg-hover); box-shadow: inset 0 0 0 1px var(--glass-border); }
  .profile-display { margin-left: auto; display: flex; align-items: center; gap: 1rem; font-size: 0.875rem; }

  /* Hamburger → X */
  .nav-toggle {
    display: none; position: relative; width: 44px; height: 44px; margin-left: auto; flex-shrink: 0;
    border: 1px solid var(--glass-border); border-radius: var(--radius-md);
    background: var(--glass-bg); cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .nav-toggle span {
    position: absolute; left: 12px; right: 12px; height: 2px; border-radius: 2px;
    background: var(--green-300);
    transition: transform 0.35s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.2s ease, top 0.35s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .nav-toggle span:nth-child(1) { top: 15px; }
  .nav-toggle span:nth-child(2) { top: 21px; }
  .nav-toggle span:nth-child(3) { top: 27px; }
  #nav-toggle:checked ~ .site-nav .nav-toggle { border-color: var(--glass-border-hover); }
  #nav-toggle:checked ~ .site-nav .nav-toggle span:nth-child(1) { top: 21px; transform: rotate(45deg); }
  #nav-toggle:checked ~ .site-nav .nav-toggle span:nth-child(2) { opacity: 0; }
  #nav-toggle:checked ~ .site-nav .nav-toggle span:nth-child(3) { top: 21px; transform: rotate(-45deg); }

  /* ── Full-page menu ── */
  .nav-overlay {
    position: fixed; inset: 0; z-index: 1100;
    display: flex; flex-direction: column;
    padding: calc(70px + 1.5rem) 1.5rem calc(1.5rem + env(safe-area-inset-bottom));
    background:
      radial-gradient(ellipse 90% 60% at 100% 0%, rgba(22, 163, 74, 0.28) 0%, transparent 60%),
      radial-gradient(ellipse 70% 50% at 0% 100%, rgba(16, 185, 129, 0.2) 0%, transparent 60%),
      rgba(2, 15, 7, 0.97);
    backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
    opacity: 0; visibility: hidden;
    clip-path: circle(0% at calc(100% - 2.5rem) 2.25rem);
    transition: clip-path 0.55s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.3s ease, visibility 0s linear 0.55s;
    overflow-y: auto;
  }
  #nav-toggle:checked ~ .nav-overlay {
    opacity: 1; visibility: visible;
    clip-path: circle(150% at calc(100% - 2.5rem) 2.25rem);
    transition: clip-path 0.6s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.2s ease, visibility 0s;
  }
  .nav-overlay-inner { width: 100%; max-width: 560px; margin: 0 auto; flex: 1; display: flex; flex-direction: column; }
  .nav-overlay-links { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .nav-overlay-links li,
  .nav-overlay-footer {
    opacity: 0; transform: translateY(18px);
    transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #nav-toggle:checked ~ .nav-overlay .nav-overlay-links li,
  #nav-toggle:checked ~ .nav-overlay .nav-overlay-footer {
    opacity: 1; transform: none;
    transition-delay: calc(0.15s + var(--i) * 0.06s);
  }
  .nav-overlay-links a {
    display: flex; align-items: center; gap: 1rem;
    padding: 1rem 1.125rem; border-radius: var(--radius-lg);
    border: 1px solid transparent; color: var(--text-primary);
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .nav-overlay-links a:hover, .nav-overlay-links a:active { background: var(--glass-bg); border-color: var(--glass-border); }
  .nav-overlay-links a.active {
    background: linear-gradient(135deg, rgba(22, 163, 74, 0.28), rgba(5, 46, 22, 0.4));
    border-color: var(--glass-border-hover);
    box-shadow: var(--shadow-green-sm);
  }
  .nav-overlay-num { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); width: 1.5rem; }
  .nav-overlay-text { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .nav-overlay-label { font-size: 1.75rem; font-weight: 600; letter-spacing: -0.03em; line-height: 1.15; color: var(--green-100); }
  .nav-overlay-hint { font-size: 0.85rem; color: var(--text-muted); }
  .nav-overlay-arrow { font-size: 1.25rem; color: var(--green-400); opacity: 0.4; transition: transform 0.2s ease, opacity 0.2s ease; }
  .nav-overlay-links a:hover .nav-overlay-arrow,
  .nav-overlay-links a.active .nav-overlay-arrow { opacity: 1; transform: translateX(3px); }
  .nav-overlay-footer {
    margin-top: auto; padding-top: 1.5rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    border-top: 1px solid var(--glass-border);
  }
  .nav-overlay-user { display: flex; align-items: center; gap: 0.75rem; color: var(--text-secondary); min-width: 0; }
  .nav-overlay-user span:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .nav-overlay-avatar {
    width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--green-700); color: var(--green-100); font-weight: 700;
    box-shadow: var(--shadow-green-sm);
  }

  @media (max-width: 768px) {
    .nav-toggle { display: block; }
    .nav-links, .profile-display { display: none; }
    :global(body:has(#nav-toggle:checked)) { overflow: hidden; }
  }
  @media (min-width: 769px) {
    .nav-overlay { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-overlay, .nav-overlay-links li, .nav-overlay-footer, .nav-toggle span { transition: none !important; }
  }
</style>
