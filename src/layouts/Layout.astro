---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Strength Trainer</title>
  </head>
  <body>
    <nav>
      <div class="container">
        <a href="/" class="logo">Strength Trainer</a>
        <div class="nav-links">
          <a href="/">Dashboard</a>
          <a href="/exercises">Exercises</a>
          <a href="/workouts">Workouts</a>
          <a href="/analytics">Analytics</a>
        </div>
      </div>
    </nav>
    <main class="container">
      <slot />
    </main>
  </body>
</html>
