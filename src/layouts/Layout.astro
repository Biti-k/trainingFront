---
import '../styles/global.css';
import '../styles/glass.css';
import '../styles/typography.css';
import '../styles/components.css';
import { AiChat } from '../components/AiChat';

interface Props {
  title: string;
}
const { title } = Astro.props;

const token = Astro.cookies.get('session')?.value;
let displayName = '';
if (token) {
  try {
    const res = await fetch(`${import.meta.env.PUBLIC_API_BASE}/auth/me`, {
      headers: { Authorization: `Bearer ${token}` },
    });
    if (res.ok) {
      const me = await res.json();
      displayName = me.name || me.email;
    }
  } catch {
    displayName = '';
  }
}
---

<script define:vars={{ token }} is:inline>
  window.__SESSION_TOKEN__ = token;
</script>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Strength Trainer</title>
  </head>
  <AiChat client:load />
  <body>
    <nav class="glass--heavy" style="border-bottom: 1px solid var(--glass-border); padding: 0.875rem 0; position: sticky; top: 0; z-index: 100;">
      <div class="container" style="display: flex; align-items: center; gap: 2rem; flex-wrap: wrap;">
        <a href="/" class="logo" style="font-weight: 700; font-size: 1.25rem; color: var(--green-100); letter-spacing: -0.02em;">
          <span class="text-glow">Strength Trainer</span>
        </a>
        <input type="checkbox" id="nav-toggle" style="display: none;" />
        <label for="nav-toggle" class="nav-toggle" style="display: none; cursor: pointer; background: none; border: 1px solid var(--glass-border); border-radius: var(--radius-sm); padding: 0.375rem 0.5rem; margin-left: auto;">
          <svg width="20" height="20" fill="none" stroke="var(--green-300)" stroke-width="2" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
          </svg>
        </label>
        <div class="nav-links" style="display: flex; gap: 1.5rem; flex: 1;">
          <a href="/" style="color: var(--text-secondary); font-weight: 500; font-size: 0.9375rem; transition: color 0.2s;">Dashboard</a>
          <a href="/exercises" style="color: var(--text-secondary); font-weight: 500; font-size: 0.9375rem; transition: color 0.2s;">Exercises</a>
          <a href="/workouts" style="color: var(--text-secondary); font-weight: 500; font-size: 0.9375rem; transition: color 0.2s;">Workouts</a>
          <a href="/analytics" style="color: var(--text-secondary); font-weight: 500; font-size: 0.9375rem; transition: color 0.2s;">Analytics</a>
        </div>
        <div id="profile-display" class="profile-display" style="margin-left: auto; display: flex; align-items: center; gap: 1rem;">
          {displayName && <span class="text-muted" style="font-size: 0.875rem;">Hi {displayName}</span>}
          <a href="/api/auth/logout" class="btn btn-ghost" style="font-size: 0.875rem;">Logout</a>
        </div>
      </div>
    </nav>
    <main class="container">
      <slot />
    </main>
  </body>
</html>

<style>
  .nav-links a:hover {
    color: var(--green-400);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: flex !important;
      align-items: center;
    }

    .nav-links {
      display: none !important;
      width: 100%;
      flex-direction: column;
      gap: 0 !important;
      padding: 0.75rem 0;
      border-top: 1px solid var(--glass-border);
      margin-top: 0.75rem;
    }

    .nav-links a {
      padding: 0.625rem 0.5rem;
      border-radius: var(--radius-sm);
      font-size: 0.9375rem;
    }

    .nav-links a:hover {
      background: var(--glass-bg);
    }

    #nav-toggle:checked ~ .nav-links {
      display: flex !important;
    }
  }
</style>
