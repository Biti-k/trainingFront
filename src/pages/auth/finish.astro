---
export const prerender = false;

const token = Astro.url.searchParams.get('token');
if (token) {
  Astro.cookies.set('session', token, {
    httpOnly: true,
    path: '/',
    maxAge: 60 * 60 * 24 * 30,
    sameSite: 'lax',
    secure: import.meta.env.PROD,
  });
}
return Astro.redirect('/');
