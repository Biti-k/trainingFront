---
import '../styles/global.css';
import '../styles/glass.css';
import '../styles/typography.css';
import '../styles/components.css';

export const prerender = false;

const apiBase = import.meta.env.PUBLIC_API_BASE;
---

<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <title>Login | Strength Trainer</title>
  </head>
  <body style="display: grid; place-items: center; min-height: 100vh;">
    <div class="glass--heavy" style="padding: 2rem; border-radius: var(--radius-lg); width: 100%; max-width: 360px; text-align: center;">
      <h1 class="text-glow" style="margin-bottom: 1.5rem; font-size: 1.5rem;">The Biti Trainer</h1>
      <a href={`${apiBase}/auth/google/login`} class="btn btn-primary" style="display: inline-block;">
        Sign in with Google
      </a>
    </div>
  </body>
</html>
